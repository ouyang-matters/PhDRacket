{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. File access goes through PhDRacket's own commands, which only read and write the files the user picks.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "updater:default",
    "process:allow-restart"
  ]
}
