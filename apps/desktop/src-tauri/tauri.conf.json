{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhDRacket",
  "version": "0.1.1",
  "identifier": "io.github.ouyang-matters.phdracket",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PhDRacket Beta",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A modern, course-conscious Racket IDE",
    "longDescription": "PhDRacket keeps Racket and HtDP as the semantic authority while providing a modern editing environment. It is an independent open-source project and is not affiliated with the University of Waterloo or the Racket project.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "licenseFile": "TERMS.txt"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NDlFOTIzNDFBNEI0ODEKUldTQnRLUkJJK2xKUkVzNlB1eDAzbHZEQ3RRL1RMcXRDREVsMFA5dk16OEhQejVmNC9DdHA5bkoK",
      "endpoints": [
        "https://raw.githubusercontent.com/ouyang-matters/PhDRacket/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
